IDD_ABOUTBOX DIALOG DISCARDABLE  0, 0, 217, 119
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Sans Serif"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,7,12,21,20
    LTEXT           "Geo-Cube 3D, Version 1.0",IDC_STATIC,40,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 1998, Weston Software",IDC_STATIC,40,24,
                    119,8
    DEFPUSHBUTTON   "OK",IDOK,161,7,49,14,WS_GROUP
    LISTBOX         IDC_LIST1,7,37,203,75,LBS_SORT | LBS_NOINTEGRALHEIGHT | 
                    WS_VSCROLL | WS_TABSTOP
END

